# Copy this file to .env.local and fill in the values you need.
# Every variable the app reads is listed here.

# Google Gemini - used to turn the uploaded image and prompt into markdown.
GEMINI_API_KEY=your_gemini_key

# Notion - Option B: internal integration token.
# Share the parent page with this integration.
NOTION_API_KEY=your_notion_integration_token

# Notion - Option A: public integration for the OAuth connect flow.
NOTION_OAUTH_CLIENT_ID=your_public_integration_client_id
NOTION_OAUTH_CLIENT_SECRET=your_public_integration_client_secret
NOTION_OAUTH_REDIRECT_URI=https://your-domain.vercel.app/api/notion/callback